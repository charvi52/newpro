# Optional live medicine resolver (Sasti Dawa Finder). Uses Google Gemini web search;
# without a key the resolver falls back to the bundled curated pharmacopoeia.
GEMINI_API_KEY=
# Optional; defaults to gemini-flash-lite-latest.
GEMINI_MODEL=

# Optional barcode-to-product lookup provider. Keep the real key private.
# Add it to Render Environment settings; never commit the key to GitHub.
OPENMRP_API_KEY=

# Render's Blueprint creates PostgreSQL and wires DATABASE_URL automatically.
# Set this yourself only when running against another PostgreSQL database.
DATABASE_URL=

# Public Supabase settings (never put a service-role key here).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute URL of the deployed site; used for social share-card links. Optional.
NEXT_PUBLIC_SITE_URL=

